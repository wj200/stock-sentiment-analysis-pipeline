# Copy to .env and fill in — docker-compose reads .env automatically.
# .env is gitignored. NEVER commit real keys.

# ── Telegram (REQUIRED to run the bot) ───────────────────────────────
# Create a bot with @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=

# ── Universe ─────────────────────────────────────────────────────────
TICKERS=AAPL,NVDA,TSLA,MSFT

# ── Ingestion sources (Feature 1) ────────────────────────────────────
# Comma-separated, any of: rss,reddit,finnhub_news
# rss needs NO credentials (real, keyless). reddit/finnhub_news need keys below.
INGEST_SOURCES=rss
INGEST_POLL_SECONDS=60

# Reddit (optional, enables the 'reddit' source) — https://www.reddit.com/prefs/apps
# Create a "script" app; user agent must be descriptive and unique.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentinel-sentiment-bot/1.0 by u/yourusername
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,StockMarket

# ── Market data (Features 1 & 2) ─────────────────────────────────────
# yfinance needs no key. Alpaca (extended-hours live quotes, Feature 2) needs keys.
MARKET_DATA_PROVIDER=yfinance          # or: alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex                    # free tier: iex ; paid: sip

# ── News for the price-move explainer (Feature 2) ────────────────────
# https://finnhub.io/  (free tier is enough for a small watchlist)
FINNHUB_API_KEY=

# ── Macro (Feature 3) ────────────────────────────────────────────────
# https://fredaccount.stlouisfed.org/apikeys  (free)
FRED_API_KEY=

# ── LLM explanation layer (Features 2 & 3) ───────────────────────────
# https://console.anthropic.com/  — used ONLY to explain events from retrieved
# sources, never in the per-post hot path.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ── Detection thresholds ─────────────────────────────────────────────
ENTRY_SENTIMENT_THRESHOLD=0.4
EXIT_SENTIMENT_THRESHOLD=-0.2
SENTIMENT_Z_WINDOW=2h                    # rolling baseline window for the z-score alert
SENTIMENT_Z_THRESHOLD=2.0                # k sigma above baseline to fire (Feature 1, A4)
SENTIMENT_Z_MIN_POSTS=5                  # ignore thin windows
PRICE_MOVE_PCT=3.0                       # % move vs prior close to alert (Feature 2)
PRICE_MOVE_Z=2.5                         # OR return z-score threshold (Feature 2)
PRICE_STALE_SECONDS=120                  # ignore quotes older than this
